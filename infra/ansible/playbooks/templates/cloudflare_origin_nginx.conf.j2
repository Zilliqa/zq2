# ABOUTME: nginx TLS front on the apps VM: Cloudflare (Full strict) -> nginx :443 -> Otterscan :80, stats :3000 and faucet :8080 on localhost.
# ABOUTME: Rendered by install_cloudflare_origin.yml; the VPC firewall only lets Cloudflare IPv4 ranges reach port 443.

ssl_certificate     {{ cloudflare_origin_tls_dir }}/origin.pem;
ssl_certificate_key {{ cloudflare_origin_tls_dir }}/origin.key;
{% if cloudflare_origin_client_verify | default('') %}

# Authenticated Origin Pulls: the firewall only proves a connection comes from Cloudflare, any Cloudflare account.
# Cloudflare presents our own client certificate for our hostnames. "optional" only logs the result, to check every
# hostname shows SUCCESS before switching to "on", which answers 400 to anything else.
ssl_client_certificate {{ cloudflare_origin_tls_dir }}/cloudflare-aop-ca.pem;
ssl_verify_client {{ cloudflare_origin_client_verify }};
log_format cloudflare_origin_aop '$time_iso8601 $host $ssl_client_verify $status';
access_log /var/log/nginx/cloudflare-origin-aop.log cloudflare_origin_aop;
{% endif %}

map $http_upgrade $cloudflare_origin_connection_upgrade {
    default upgrade;
    ''      close;
}

# Refuse hosts we do not serve (e.g. another Cloudflare zone pointed at this IP) during the TLS handshake.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    server_name {{ cloudflare_origin_otterscan_hosts | join(' ') }};

    location / {
        proxy_pass http://127.0.0.1:80;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}

{% if cloudflare_origin_otterscan_redirect_hosts %}
server {
    listen 443 ssl;
    server_name {{ cloudflare_origin_otterscan_redirect_hosts | join(' ') }};

    return 301 https://{{ cloudflare_origin_otterscan_hosts | first }}$request_uri;
}

{% endif %}
{% if cloudflare_origin_faucet_hosts | default([]) %}
server {
    listen 443 ssl;
    server_name {{ cloudflare_origin_faucet_hosts | join(' ') }};

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # The visitor address as seen by Cloudflare; the per-IP limit itself is a Cloudflare rate limiting rule.
        proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
    }
}

{% endif %}
server {
    listen 443 ssl;
    server_name {{ cloudflare_origin_stats_hosts | join(' ') }};

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $cloudflare_origin_connection_upgrade;
        # Stats agents keep one WebSocket open; Cloudflare closes idle ones after 100 s anyway.
        proxy_read_timeout 1h;
    }
}
